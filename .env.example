# Slack Bot Configuration Example
# Copy this file to '.env' and fill in your real credentials

PORT=3000

# Slack Application Credentials
# (Can be found in the Slack Developer Portal: https://api.slack.com/apps)
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=9b391651470149f61d8886a457364d89

# Optional Channel Names or Channel IDs (e.g. C0123456789)
# If not specified, the system will automatically search the Slack workspace
# for channels named '#general', '#lrf-approvals', and '#finance'.
SLACK_CHANNEL_GENERAL=#general
SLACK_CHANNEL_APPROVALS=#lrf-approvals
SLACK_CHANNEL_FINANCE=#finance
